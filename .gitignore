# ─────────────────────────────────────────────────────────────
# .gitignore cho project book-course-vibe
# Mục đích: git ở đây chỉ để lưu LỊCH SỬ THAY ĐỔI trên máy bạn.
# Không phải để đăng lên internet. Xem README.md phần 5.
# ─────────────────────────────────────────────────────────────

# ── 1. Nội dung có bản quyền — TUYỆT ĐỐI không đưa vào git ──
# Sách gốc đã mua (34 MB). Chỉ dùng cá nhân, không phát hành lại.
Android_Fundamentals_by_Tutorials_v1.0.0.epub

# Văn bản sách đã trích ra chữ. Đây là nguyên văn sách nên cũng
# có bản quyền. File vẫn nằm trên máy bạn bình thường, chỉ là
# git không theo dõi. Nếu mất, tạo lại bằng:
#     python scripts/extract_epub.py --all
content/book/

# ── 2. Repo git riêng của project Android mẫu ──
# aaf-materials/ đã có git riêng (remote kodecocodes/aaf-materials).
# Không lồng nó vào git của mình để tránh xung đột.
aaf-materials/

# ── 3. Thứ máy tự sinh ra, tạo lại được ──
web/node_modules/
web/dist/
web/.astro/
node_modules/

# ── 4. File tạm / log ──
*.log
npm-debug.log*
build-*.txt
build_*.txt

# ── 5. File rác của hệ điều hành & IDE ──
Thumbs.db
desktop.ini
.DS_Store
.idea/

# ── 6. File tạm audit/scratch cục bộ (dump so sánh, đếm từ, probe build)
#    Giữ nguyên trên máy + trong backup, không đưa vào git ──
/web/.*.txt
/web/.*.py
/web/.*.css
/web/.ch03crit/
/web/scripts/
/web/content-baseline.txt
/web/src/components/lessons/.*.txt
/scripts/.*.txt
/.wc3_3.txt
*.stackdump

# link-xref.py ghi bao cao ra GOC repo moi lan chay — ke ca dry-run — nen
# `pnpm run check:xref` (mot lenh KIEM TRA) lam ban git status. Chan o day.
/link-xref-report.json

# ── 7. Tooling local: Claude skills
#    Chứa 3 repo clone lồng nhau có .git riêng → commit sẽ tạo gitlink
#    "embedded repo" lỗi. Giữ trên máy, không track. ──
/.claude/
