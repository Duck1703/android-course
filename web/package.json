{
  "name": "web",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check:structure": "node tools/check-lesson-structure.mjs",
    "check:types": "astro check",
    "check:progress": "node scripts-maintenance/progress_g_audit.mjs",
    "check:counts": "node scripts-maintenance/check_counts.mjs",
    "check:anchors": "python tools/check-anchors.py",
    "check:redirects": "python tools/check-redirects.py",
    "check:practice": "python tools/audit-practice.py",
    "check:refs": "python tools/audit-practice-refs.py",
    "check:long": "python tools/find-long-paragraphs.py",
    "check:html": "python tools/audit-html-quality.py",
    "check:all": "node tools/check-lesson-structure.mjs && astro check && python tools/audit-practice.py && node scripts-maintenance/progress_g_audit.mjs && astro build && node scripts-maintenance/check_counts.mjs && python tools/check-anchors.py && python tools/check-redirects.py",
    "check:xref": "python tools/link-xref.py",
    "fix:xref": "python tools/link-xref.py --apply",
    "check:braces": "python tools/fix-unescaped-braces.py",
    "fix:braces": "python tools/fix-unescaped-braces.py --apply",
    "fix:order": "node tools/normalize-lesson-order.mjs --apply"
  },
  "dependencies": {
    "astro": "7.2.8"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@10.34.5"
}
