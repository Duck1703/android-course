---
import { ALL_CHAPTERS, chapterLabel, groupChaptersByStage } from "../data/chapters";
import { getStats } from "../data/lessonStats";
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname;

// Index tim kiem — dung 100% du lieu da co: ten chapter, tom tat, va tung muc
// <h2> that trong file lesson (lay qua lessonStats). Khong tao noi dung moi.
const searchIndex = ALL_CHAPTERS.flatMap((ch) => {
  const base = `/chapters/${ch.slug}/`;
  const label = chapterLabel(ch);
  const rows = [
    {
      t: ch.title,
      c: `Chương ${label}`,
      u: base,
      k: `${label} ${ch.title} ${ch.summaryVi} ${ch.parentTitle ?? ""}`.toLowerCase(),
    },
  ];
  for (const h of getStats(ch.slug).headings) {
    rows.push({
      t: h.text,
      c: `Chương ${label} · ${ch.title}`,
      u: `${base}#${h.id}`,
      k: h.text.toLowerCase(),
    });
  }
  return rows;
});

// So chuong lon — dung cho nhan "11 chuong" o dau rail. Cac chuong nho (10.1..10.4)
// van la 4 trang rieng, nhung nguoi hoc dem chuong theo chuong lon.
const totalChapters = new Set(ALL_CHAPTERS.map((c) => c.number)).size;

// Sidebar theo STAGE (IMP-011): thu tu nhom doc tu STAGES, bai hoc doc tu
// ALL_CHAPTERS qua groupChaptersByStage. Stage khong con bai live (foundation,
// navigation, appendix hien nay) khong tra ve -> tu dong an, khong co placeholder.
// Nhom "core" mo san (cung nhu trang chu) de nguoi hoc thay ca lo trinh;
// nhom optional/appendix ("Mở rộng") thu lai, chi tu mo khi bai active nam trong do.
const stageGroups = groupChaptersByStage(ALL_CHAPTERS).map((group) => {
  const { stage, chapters } = group;
  const hasCurrent = chapters.some((c) => currentPath === `/chapters/${c.slug}/`);
  // Nhom cha da tach (chuong lon co >= 2 chuong nho, vd 10.1..10.4): renderer
  // se chen mot tieu de nho roi thut cac chuong nho vao duoi. Chuong nguyen khoi
  // (Ch05, Ch07, Ch08, Ch09, Ch11) render truc tiep, khong co tieu de con.
  const seenNumbers = new Map<number, number>();
  for (const c of chapters) {
    seenNumbers.set(c.number, (seenNumbers.get(c.number) ?? 0) + 1);
  }
  const splitNumbers = new Set<number>();
  for (const [num, count] of seenNumbers) {
    if (count >= 2 && chapters.some((c) => c.number === num && c.subNumber !== undefined)) {
      splitNumbers.add(num);
    }
  }
  return {
    stage,
    chapters,
    splitNumbers,
    open: stage.kind === "core" ? hasCurrent || currentPath === "/" : hasCurrent,
  };
});
---

<html lang="vi">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="color-scheme" content="light dark" />
		<title>{title} · Học Android tiếng Việt</title>
		<script is:inline>
			// Chay TRUOC khi trang ve — tranh nhay mau khi dang o dark theme.
			try {
				const saved = localStorage.getItem("hoc-android-tv:theme");
				const dark =
					saved === "dark" ||
					(!saved && window.matchMedia("(prefers-color-scheme: dark)").matches);
				if (dark) document.documentElement.dataset.theme = "dark";
			} catch (e) {
				/* localStorage bi chan: bo qua, dung light theme */
			}
		</script>
	</head>
	<body>
		<a class="skip-link" href="#main">Bỏ qua điều hướng, tới nội dung</a>

		<header class="topbar">
			<button
				class="icon-btn"
				id="menu-toggle"
				type="button"
				aria-label="Mở danh sách chương"
				aria-expanded="false"
			>
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
					<path d="M3 6h18M3 12h18M3 18h18"></path>
				</svg>
			</button>

			<a class="brand" href="/">
				<span class="brand-mark" aria-hidden="true">
					<!-- Bieu tuong con robot Android don gian -->
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
						<path d="M7 9a5 5 0 0 1 10 0v7H7z"></path>
						<path d="M8.5 5.5 7.4 3.7M15.5 5.5l1.1-1.8"></path>
						<path d="M4.6 10.5v4.4M19.4 10.5v4.4"></path>
						<path d="M10 19v1.6M14 19v1.6"></path>
						<path d="M10 12h.01M14 12h.01"></path>
					</svg>
				</span>
				<span class="brand-text">
					<span class="brand-title">Android Jetpack Compose</span>
					<span class="brand-sub">Khoá học tiếng Việt</span>
				</span>
			</a>

			<div class="topbar-search">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
					<circle cx="11" cy="11" r="7"></circle>
					<path d="m16.5 16.5 4 4"></path>
				</svg>
				<input
					type="search"
					id="lesson-search"
					placeholder="Tìm chương, mục…"
					autocomplete="off"
					role="combobox"
					aria-expanded="false"
					aria-autocomplete="list"
					aria-controls="search-results"
					aria-label="Tìm trong khoá học"
				/>
				<ul id="search-results" role="listbox" aria-label="Kết quả tìm kiếm" hidden></ul>
			</div>

			<div class="topbar-progress" title="Tiến độ toàn khoá">
				<span class="tp-track" aria-hidden="true"><span class="tp-fill" id="tp-fill"></span></span>
				<span class="tp-label" id="tp-label">0/{ALL_CHAPTERS.length} phần</span>
			</div>

			<button class="icon-btn" id="theme-toggle" type="button" aria-label="Đổi sáng/tối">
				<svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
					<circle cx="12" cy="12" r="4"></circle>
					<path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M18.4 5.6 17 7M7 17l-1.4 1.4"></path>
				</svg>
				<svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a7 7 0 1 0 10.5 10.5z"></path>
				</svg>
			</button>
		</header>


		<div class="shell">
			<aside class="rail" id="rail" aria-label="Chương trình học">
				<div class="rail-head">
					<p class="rail-title">Chương trình học</p>
					<span class="rail-count">{totalChapters} chương</span>
				</div>
				<nav>
					{
						stageGroups.map((group) => {
							const { stage, chapters, splitNumbers, open } = group;
							const slugs = chapters.map((c) => c.slug);
							return (
								<details class="module" open={open} data-mod={slugs.join(",")}>
									<summary>
										<span class="module-num" aria-hidden="true">{stage.order}</span>
										<span class="module-meta">
											<span class="module-title">{stage.label}</span>
											<span class="module-sub">
												<span class="mod-done">0</span>/{chapters.length} chương xong
											</span>
											<span class="module-bar" aria-hidden="true"><span></span></span>
										</span>
										<svg class="module-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
											<path d="M9 5l7 7-7 7"></path>
										</svg>
									</summary>
									<ul>
										{chapters.map((ch) => {
											// Chuong lon da tach (vd 10.1..10.4): dung CHINH chuong dau tien
											// cua chuong lon de render tieu de nhom + toan bo cac chuong nho;
											// cac chuong nho sau bo qua de khong bi render trung.
											const isGroupHead = splitNumbers.has(ch.number) && ch.subNumber === 1;
											if (splitNumbers.has(ch.number) && !isGroupHead) return null;
											const rows = (
												<li>
													<a
														href={`/chapters/${ch.slug}/`}
														class={currentPath === `/chapters/${ch.slug}/` ? "active" : ""}
														data-slug={ch.slug}
														aria-current={currentPath === `/chapters/${ch.slug}/` ? "page" : undefined}
													>
														<span class="num">{chapterLabel(ch)}</span>
														{ch.title}
														<svg class="check" role="img" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-label="Đã học">
															<path d="M4 12.5l5 5L20 6.5"></path>
														</svg>
													</a>
												</li>
											);

											if (!isGroupHead) return rows;

											const siblings = chapters.filter((c) => c.number === ch.number);											return (
												<li class="ch-group">
													<p class="ch-group-head">
														<span class="num">{ch.number}</span>
														<span>{ch.parentTitle ?? ch.title}</span>
														<span class="ch-group-count">{siblings.length} phần</span>
													</p>
													<ul class="ch-group-list">
														{siblings.map((sub) => {
															const href = `/chapters/${sub.slug}/`;
															const active = currentPath === href;
															return (
																<li>
																	<a
																		href={href}
																		class={active ? "active" : ""}
																		data-slug={sub.slug}
																		aria-current={active ? "page" : undefined}
																	>
																		<span class="num">{chapterLabel(sub)}</span>
																		{sub.title}
																		<svg class="check" role="img" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-label="Đã học">
																			<path d="M4 12.5l5 5L20 6.5"></path>
																		</svg>
																	</a>
																</li>
															);
														})}
													</ul>
												</li>
											);
										})}
									</ul>
								</details>
							);
						})
					}
				</nav>
			</aside>

			<div class="rail-overlay" id="rail-overlay" aria-hidden="true"></div>
			<main class="content" id="main">
				<div class="content-inner">
					<slot />
				</div>
			</main>
		</div>

		<script
			is:inline
			type="application/json"
			id="search-index"
			set:html={JSON.stringify(searchIndex)}
		/>
	</body>
</html>

<script>
	// ------------------------------------------------------------------ theme --
	const THEME_KEY = "hoc-android-tv:theme";
	const themeBtn = document.getElementById("theme-toggle");

	function applyTheme(dark: boolean) {
		if (dark) document.documentElement.dataset.theme = "dark";
		else delete document.documentElement.dataset.theme;
		themeBtn?.setAttribute("aria-label", dark ? "Chuyển sang giao diện sáng" : "Chuyển sang giao diện tối");
	}

	applyTheme(document.documentElement.dataset.theme === "dark");

	themeBtn?.addEventListener("click", () => {
		const dark = document.documentElement.dataset.theme !== "dark";
		applyTheme(dark);
		try {
			localStorage.setItem(THEME_KEY, dark ? "dark" : "light");
		} catch (e) {
			/* localStorage bi chan: theme chi doi trong phien nay */
		}
	});

	// --------------------------------------------------- tien do o rail + header
	// Nguon du lieu: localStorage "hoc-android-tv:progress" (khong doi).
	import { getDoneSlugs } from "../lib/progress";

	function paintProgress() {
		const done = new Set(getDoneSlugs());
		const links = document.querySelectorAll<HTMLAnchorElement>("nav a[data-slug]");

		links.forEach((a) => {
			const slug = a.dataset.slug;
			a.classList.toggle("done", !!slug && done.has(slug));
		});

		// Thanh tien do tong o header
		const total = links.length;
		const n = [...links].filter((a) => a.classList.contains("done")).length;
		const pct = total ? Math.round((n / total) * 100) : 0;
		const fill = document.getElementById("tp-fill");
		const label = document.getElementById("tp-label");
		if (fill) fill.style.width = `${pct}%`;
		if (label) label.textContent = `${n}/${total} phần`;

		// Tien do tung module
		document.querySelectorAll<HTMLElement>(".module[data-mod]").forEach((mod) => {
			const slugs = (mod.dataset.mod || "").split(",").filter(Boolean);
			const d = slugs.filter((s) => done.has(s)).length;
			const cnt = mod.querySelector(".mod-done");
			if (cnt) cnt.textContent = String(d);
			const bar = mod.querySelector<HTMLElement>(".module-bar span");
			if (bar) bar.style.width = slugs.length ? `${(d / slugs.length) * 100}%` : "0%";
		});
	}

	paintProgress();
	// ProgressToggle phat su kien nay sau khi nguoi hoc bam danh dau.
	document.addEventListener("progress-changed", paintProgress);

	// ---------------------------------------------------- drawer tren mobile ---
	const menuBtn = document.getElementById("menu-toggle");
	const overlay = document.getElementById("rail-overlay");

	function setRail(open: boolean) {
		document.body.classList.toggle("rail-open", open);
		menuBtn?.setAttribute("aria-expanded", String(open));
	}

	menuBtn?.addEventListener("click", () => {
		setRail(!document.body.classList.contains("rail-open"));
	});
	overlay?.addEventListener("click", () => setRail(false));

	// Escape dong drawer va tra con tro ve nut mo — nguoi dung ban phim khong
	// phai Tab nguoc lai tim nut.
	document.addEventListener("keydown", (e) => {
		if (e.key === "Escape" && document.body.classList.contains("rail-open")) {
			setRail(false);
			menuBtn?.focus();
		}
	});

	// Bam vao 1 bai trong drawer thi dong drawer lai.
	document.querySelectorAll("nav a[data-slug]").forEach((a) => {
		a.addEventListener("click", () => setRail(false));
	});

	// Cuon rail sao cho bai dang hoc nam trong tam nhin.
	const activeLink = document.querySelector<HTMLAnchorElement>("nav a[data-slug].active");
	if (activeLink) {
		const rail = document.getElementById("rail");
		if (rail && activeLink.offsetTop > rail.clientHeight - 120) {
			rail.scrollTop = activeLink.offsetTop - rail.clientHeight / 2;
		}
	}

	// ------------------------------------------------------------- tim kiem ----
	// Index duoc render san o build time (the <script type="application/json">),
	// nen tim kiem chay ngay tren client, khong can server.
	interface Hit {
		t: string;
		c: string;
		u: string;
		k: string;
	}

	const idxEl = document.getElementById("search-index");
	const INDEX: Hit[] = idxEl?.textContent ? JSON.parse(idxEl.textContent) : [];

	const input = document.getElementById("lesson-search") as HTMLInputElement | null;
	const panel = document.getElementById("search-results");
	let hits: Hit[] = [];
	let cursor = -1;

	// Bo dau tieng Viet de "du lieu" tim duoc "dữ liệu", "compose" tim duoc "Compose".
	function fold(s: string): string {
		return s
			.normalize("NFD")
			.replace(/[̀-ͯ]/g, "")
			.replace(/đ/g, "d")
			.replace(/Đ/g, "D");
	}

	// Tieu de muc co the chua ky tu < > " sau khi bo the HTML — phai escape lai.
	function esc(s: string): string {
		return s
			.replace(/&/g, "&amp;")
			.replace(/</g, "&lt;")
			.replace(/>/g, "&gt;")
			.replace(/"/g, "&quot;");
	}

	function closePanel() {
		if (!panel) return;
		panel.hidden = true;
		panel.innerHTML = "";
		input?.setAttribute("aria-expanded", "false");
		input?.removeAttribute("aria-activedescendant");
		hits = [];
		cursor = -1;
	}

	function render() {
		if (!panel) return;
		if (!hits.length) {
			panel.innerHTML = '<li class="res-empty">Không tìm thấy nội dung nào.</li>';
		} else {
			panel.innerHTML = hits
				.map(
					(h, i) =>
						`<li id="sr-${i}" role="option" aria-selected="${i === cursor}"><a href="${h.u}" class="${i === cursor ? "hl" : ""}">${esc(h.t)}<span class="res-ch">${esc(h.c)}</span></a></li>`
				)
				.join("");
		}
		panel.hidden = false;
		input?.setAttribute("aria-expanded", "true");
		// aria-activedescendant cho screen reader biet dong nao dang duoc chon
		// khi nguoi dung bam mui ten — chi doi mau chu thi ho khong biet.
		if (cursor >= 0) input?.setAttribute("aria-activedescendant", `sr-${cursor}`);
		else input?.removeAttribute("aria-activedescendant");
	}

	input?.addEventListener("input", () => {
		const q = fold(input.value.trim().toLowerCase());
		if (q.length < 2) {
			closePanel();
			return;
		}
		// Uu tien ket qua khop tu dau chuoi, roi moi den khop giua chuoi.
		const scored: Array<{ h: Hit; s: number }> = [];
		for (const h of INDEX) {
			const pos = fold(h.k).indexOf(q);
			if (pos >= 0) scored.push({ h, s: pos });
		}
		scored.sort((a, b) => a.s - b.s);
		hits = scored.slice(0, 12).map((x) => x.h);
		cursor = -1;
		render();
	});

	input?.addEventListener("keydown", (e) => {
		if (e.key === "Escape") {
			closePanel();
			input.blur();
			return;
		}
		if (!hits.length) return;
		if (e.key === "ArrowDown") {
			e.preventDefault();
			cursor = (cursor + 1) % hits.length;
			render();
		} else if (e.key === "ArrowUp") {
			e.preventDefault();
			cursor = cursor <= 0 ? hits.length - 1 : cursor - 1;
			render();
		} else if (e.key === "Enter" && cursor >= 0) {
			e.preventDefault();
			window.location.href = hits[cursor]!.u;
		}
	});

	document.addEventListener("click", (e) => {
		const t = e.target as Node;
		if (!panel?.contains(t) && t !== input) closePanel();
	});

	// Ctrl/Cmd + K de nhay vao o tim kiem.
	document.addEventListener("keydown", (e) => {
		if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "k") {
			e.preventDefault();
			input?.focus();
			input?.select();
		}
	});




</script>


