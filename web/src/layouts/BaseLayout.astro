---
import { SECTIONS } from "../data/chapters";

interface Props {
  title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname;
---

<html lang="vi">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} · Học Android tiếng Việt</title>
	</head>
	<body>
		<div class="shell">
			<aside class="sidebar">
				<a class="brand" href="/">Học Android bằng tiếng Việt</a>
				<p class="brand-sub">Dựa theo sách <em>Android Fundamentals by Tutorials</em></p>
				<nav>
					{
						SECTIONS.map((section) => (
							<div class="section">
								<h2>{section.title}</h2>
								<ul>
									{section.chapters.map((ch) => {
										const href = `/chapters/${ch.slug}/`;
										const active = currentPath === href;
										return (
											<li>
												<a href={href} class={active ? "active" : ""} data-slug={ch.slug}>
													<span class="num">{ch.number}</span>
													{ch.title}
													<span class="check">✓</span>
												</a>
											</li>
										);
									})}
								</ul>
							</div>
						))
					}
				</nav>
			</aside>
			<main>
				<slot />
			</main>
		</div>
	</body>
</html>

<script>
	// Task 9 — đọc localStorage, đánh dấu chapter đã học ở sidebar (checkmark ẩn/hiện qua class "done").
	import { getDoneSlugs } from "../lib/progress";

	const done = new Set(getDoneSlugs());
	document.querySelectorAll<HTMLAnchorElement>("nav a[data-slug]").forEach((a) => {
		const slug = a.dataset.slug;
		if (slug && done.has(slug)) a.classList.add("done");
	});
</script>

<style>
	:global(*) {
		box-sizing: border-box;
	}
	:global(body) {
		margin: 0;
		font-family: system-ui, "Segoe UI", sans-serif;
		color: #1a1a1a;
		background: #fafafa;
	}
	.shell {
		display: flex;
		min-height: 100vh;
	}
	.sidebar {
		width: 280px;
		flex-shrink: 0;
		background: #171923;
		color: #e2e8f0;
		padding: 1.5rem 1rem;
		overflow-y: auto;
	}
	.brand {
		display: block;
		color: #fff;
		font-weight: 700;
		font-size: 1.05rem;
		text-decoration: none;
		line-height: 1.3;
	}
	.brand-sub {
		font-size: 0.78rem;
		color: #9aa5b1;
		margin: 0.4rem 0 1.4rem;
	}
	.section h2 {
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: #718096;
		margin: 1.2rem 0 0.4rem;
	}
	.section ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.section li a {
		display: flex;
		gap: 0.5rem;
		align-items: baseline;
		padding: 0.35rem 0.5rem;
		border-radius: 6px;
		color: #cbd5e0;
		text-decoration: none;
		font-size: 0.9rem;
	}
	.section li a:hover {
		background: #262b38;
		color: #fff;
	}
	.section li a.active {
		background: #2b6cb0;
		color: #fff;
	}
	.num {
		font-variant-numeric: tabular-nums;
		color: #718096;
		font-size: 0.8rem;
	}
	.section li a.active .num {
		color: #cfe3f7;
	}
	.check {
		display: none;
		margin-left: auto;
		color: #68d391;
		font-size: 0.85rem;
	}
	.section li a.done .check {
		display: inline;
	}
	main {
		flex: 1;
		padding: 2.5rem 3rem;
		max-width: 860px;
	}
	@media (max-width: 800px) {
		.shell {
			flex-direction: column;
		}
		.sidebar {
			width: 100%;
		}
		main {
			padding: 1.5rem;
		}
	}
</style>
