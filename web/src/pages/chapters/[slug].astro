---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProgressToggle from "../../components/ProgressToggle.astro";
import CodeEnhance from "../../components/CodeEnhance.astro";
import { ALL_CHAPTERS, SECTIONS, chapterLabel } from "../../data/chapters";
import { LESSONS } from "../../data/lessons";
import { getStats } from "../../data/lessonStats";

export function getStaticPaths() {
	return ALL_CHAPTERS.map((ch) => ({
		params: { slug: ch.slug },
		props: { chapter: ch },
	}));
}

const { chapter } = Astro.props;
const sectionIndex = SECTIONS.findIndex((s) => s.chapters.some((c) => c.slug === chapter.slug));
const section = SECTIONS[sectionIndex];
const moduleLabel = section ? (section.title.split(": ")[1] ?? section.title) : "";

// Nhãn chương: "10.2" khi chương lớn đã tách, "9" khi còn nguyên khối.
const label = chapterLabel(chapter);

// Đếm theo CHƯƠNG LỚN để con số ở chip không nhảy vọt khi tách chương:
// "Chương 10.2 / 11 chương" chứ không phải "/ 14".
const totalChapters = new Set(ALL_CHAPTERS.map((c) => c.number)).size;

// Task 10 — registry: mỗi chapter đã có lesson đăng ký cặp {Lesson, Quiz} trong data/lessons.ts.
// Chapter chưa có trong registry vẫn hiện placeholder — không cần sửa file này khi thêm lesson mới.
const entry = LESSONS[chapter.slug];
const Lesson = entry?.Lesson;
const Quiz = entry?.Quiz;

// Số liệu + mục lục: đếm từ chính file lesson/quiz ở build time (data/lessonStats.ts).
const stats = getStats(chapter.slug);

const idx = ALL_CHAPTERS.findIndex((c) => c.slug === chapter.slug);
const prev = idx > 0 ? ALL_CHAPTERS[idx - 1] : undefined;
const next = idx >= 0 && idx < ALL_CHAPTERS.length - 1 ? ALL_CHAPTERS[idx + 1] : undefined;
---

<BaseLayout title={`Chương ${label}: ${chapter.title}`}>
	<div class="lesson-layout">
		<div class="lesson-main">
			<nav class="crumb" aria-label="Đường dẫn">
				<a href="/">Khoá học</a>
				<span class="sep" aria-hidden="true">/</span>
				<span>Phần {sectionIndex + 1}</span>
				{
					chapter.parentTitle && (
						<>
							<span class="sep" aria-hidden="true">/</span>
							<span>Chương {chapter.number} — {chapter.parentTitle}</span>
						</>
					)
				}
				<span class="sep" aria-hidden="true">/</span>
				<span class="cur">Chương {label}</span>
			</nav>

			<header class="lesson-head">
				<div class="lesson-eyebrow">
					<span class="chip chip-primary">Module {sectionIndex + 1} · {moduleLabel}</span>
					<span class="chip chip-plain">Chương {label} · {totalChapters} chương</span>
					<span class="chip chip-done" id="lesson-status" hidden>
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M4 12.5l5 5L20 6.5"></path>
						</svg>
						Đã hoàn thành
					</span>
				</div>

				<h1>{chapter.title}</h1>
				<p class="summary">{chapter.summaryVi}</p>

				{
					stats.sections > 0 && (
						<ul class="lesson-stats">
							<li>
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<circle cx="12" cy="12" r="9" />
									<path d="M12 7.5V12l3 2" />
								</svg>
								<span>khoảng <b>{stats.minutes}</b> phút</span>
							</li>
							<li>
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="M4 6h16M4 12h16M4 18h10" />
								</svg>
								<span><b>{stats.sections}</b> mục</span>
							</li>
							<li>
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="M9 6 4 12l5 6M15 6l5 6-5 6" />
								</svg>
								<span><b>{stats.codeBlocks}</b> khối code</span>
							</li>
							<li>
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<rect x="3" y="3" width="18" height="18" rx="3" />
									<path d="M9.5 9a2.5 2.5 0 1 1 3.4 2.3c-.6.3-.9.9-.9 1.5v.4M12 16.5h.01" />
								</svg>
								<span><b>{stats.quizQuestions}</b> câu hỏi</span>
							</li>
						</ul>
					)
				}
			</header>


			<!-- The tong quan: dieu can chuan bi + nguon tham chieu.
			     Muc tieu hoc tap (learning outcomes) nam ngay dau lesson trong
			     .callout.goals — da co san trong tung file lesson. -->
			<section class="overview" aria-label="Tổng quan chương">
				<div class="overview-grid">
					<div class="overview-cell">
						<h2>
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M12 3v18M5 10l7-7 7 7" />
							</svg>
							Trước khi vào chương
						</h2>
						<ul>
							{
								prev ? (
									<li>
										<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
											<path d="M4 12.5l5 5L20 6.5" />
										</svg>
										<span>
											Nên học xong <a href={`/chapters/${prev.slug}/`}>Chương {chapterLabel(prev)} — {prev.title}</a>
										</span>
									</li>
								) : (
									<li>
										<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
											<path d="M4 12.5l5 5L20 6.5" />
										</svg>
										<span>Đây là chương đầu tiên — không cần kiến thức Android nào trước đó.</span>
									</li>
								)
							}
							<li>
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="M4 12.5l5 5L20 6.5" />
								</svg>
								<span>
									{
										chapter.hasProject
											? "Mở project mẫu của chương này để đối chiếu code khi đọc."
											: "Chương này thiên về khái niệm, chưa cần mở Android Studio."
									}
								</span>
							</li>
							<li>
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="M4 12.5l5 5L20 6.5" />
								</svg>
								<span>Dành khoảng <b>{stats.minutes} phút</b> đọc liền mạch sẽ dễ theo hơn.</span>
							</li>
						</ul>
					</div>

					<div class="overview-cell source">
						<h2>
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H19v18H6.5A2.5 2.5 0 0 1 4 18.5z" />
								<path d="M8 7h7M8 11h7" />
							</svg>
							Nguồn tham chiếu
						</h2>
						<ul>
							<li>
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H19v18H6.5A2.5 2.5 0 0 1 4 18.5z" />
								</svg>
								<span>
									Sách <em>Android Fundamentals by Tutorials</em> (Kodeco) — chương {chapter.number}
								</span>
							</li>
							<li>
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="M3 7.5A1.5 1.5 0 0 1 4.5 6h4l2 2.2h7a1.5 1.5 0 0 1 1.5 1.5v7.8A1.5 1.5 0 0 1 17.5 19h-13A1.5 1.5 0 0 1 3 17.5z" />
								</svg>
								<span>
									Project mẫu: <code>aaf-materials/{chapter.aafFolder}/</code>
									{!chapter.hasProject && (
										<span class="hint"> Chương này không có project Android thật.</span>
									)}
								</span>
							</li>
						</ul>
					</div>
				</div>
			</section>


			{
				Lesson ? (
					<>
						<Lesson />
						{/* AP1–AP3: reference zero-quiz — entry không có Quiz → chỉ render bài (Workstream F §24: no fake empty quiz) */}
						{Quiz && <Quiz />}
					</>
				) : (
					<div class="placeholder">
						<p>Nội dung chi tiết cho chương này đang được biên soạn.</p>
						<p class="ph-note">
							Xem tiến độ tại <code>docs/PROJECT_PLAN.md</code>. Chương sẽ gồm: giải thích khái niệm, code
							thật từ project mẫu (kèm chỉ rõ file), và bài tập/quiz nhỏ.
						</p>
					</div>
				)
			}


			<nav class="lesson-nav" aria-label="Điều hướng chương">
				{
					prev ? (
						<a class="nav-card prev" href={`/chapters/${prev.slug}/`} rel="prev">
							<span class="nav-dir">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="M19 12H6M11 6l-6 6 6 6" />
								</svg>
								Chương trước
							</span>
							<span class="nav-title">{chapterLabel(prev)}. {prev.title}</span>
						</a>
					) : (
						<span class="nav-card prev empty">
							<span class="nav-dir">Chương trước</span>
							<span class="nav-title">Đây là chương đầu tiên</span>
						</span>
					)
				}

				<ProgressToggle slug={chapter.slug} />

				{
					next ? (
						<a class="nav-card next" href={`/chapters/${next.slug}/`} rel="next">
							<span class="nav-dir">
								Chương tiếp theo
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="M5 12h13M13 6l6 6-6 6" />
								</svg>
							</span>
							<span class="nav-title">{chapterLabel(next)}. {next.title}</span>
						</a>
					) : (
						<span class="nav-card next empty">
							<span class="nav-dir">Chương tiếp theo</span>
							<span class="nav-title">Bạn đã tới chương cuối</span>
						</span>
					)
				}
			</nav>

		</div>

		{
			stats.headings.length > 0 && (
				<aside class="toc" aria-label="Mục lục chương">
					<h2>Trong chương này</h2>
					<ol>
						{stats.headings.map((h) => (
							<li>
								<a href={`#${h.id}`}>{h.text}</a>
							</li>
						))}
					</ol>
				</aside>
			)
		}

	</div>

	<CodeEnhance />
</BaseLayout>

<script>
	// --- Chip "Đã hoàn thành" ở đầu bài, đồng bộ với nút #progress-btn ---
	const btn = document.getElementById("progress-btn");
	const statusChip = document.getElementById("lesson-status");

	function syncStatus() {
		if (statusChip) statusChip.hidden = !btn?.classList.contains("done");
	}
	syncStatus();
	document.addEventListener("progress-changed", syncStatus);

	// --- TOC: đánh dấu mục đang đọc ---
	const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>(".toc a[href^='#']")];
	if (tocLinks.length) {
		const byId = new Map(tocLinks.map((a) => [decodeURIComponent(a.hash.slice(1)), a]));
		const targets = [...byId.keys()]
			.map((id) => document.getElementById(id))
			.filter((el): el is HTMLElement => !!el);

		let current: HTMLAnchorElement | null = null;
		const setCurrent = (a: HTMLAnchorElement | null) => {
			if (a === current) return;
			current?.classList.remove("cur");
			a?.classList.add("cur");
			current = a;
		};

		// Mục nào đang ở gần đỉnh khung nhìn thì mục đó là mục đang đọc.
		const io = new IntersectionObserver(
			(entries) => {
				const visible = entries
					.filter((e) => e.isIntersecting)
					.sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
				if (visible[0]) setCurrent(byId.get(visible[0].target.id) ?? null);
			},
			{ rootMargin: "-72px 0px -70% 0px", threshold: 0 }
		);
		targets.forEach((t) => io.observe(t));
	}
</script>

