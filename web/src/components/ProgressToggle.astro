---
// Task 9 — nút đánh dấu "đã học" cho 1 chapter, lưu vào localStorage (không cần backend).
interface Props {
	slug: string;
}
const { slug } = Astro.props;
---

<div class="progress-toggle">
	<button id="progress-btn" data-slug={slug} type="button">Đánh dấu đã học chương này</button>
</div>

<script>
	import { isDone, toggleDone } from "../lib/progress";

	const btn = document.getElementById("progress-btn") as HTMLButtonElement | null;

	function render() {
		if (!btn?.dataset.slug) return;
		const done = isDone(btn.dataset.slug);
		btn.textContent = done ? "Đã học — bấm để bỏ đánh dấu" : "Đánh dấu đã học chương này";
		btn.classList.toggle("done", done);
		btn.setAttribute("aria-pressed", String(done));
	}

	btn?.addEventListener("click", () => {
		if (!btn.dataset.slug) return;
		toggleDone(btn.dataset.slug);
		render();
		document
			.querySelectorAll<HTMLAnchorElement>(`nav a[data-slug="${btn.dataset.slug}"]`)
			.forEach((a) => a.classList.toggle("done", isDone(btn.dataset.slug!)));

		// Thông báo cho header/rail/chip trạng thái cùng cập nhật lại.
		document.dispatchEvent(new CustomEvent("progress-changed", { detail: btn.dataset.slug }));
	});

	render();
</script>
