		<div class="ba-col">
			<div class="ba-head bad">Sách in</div>
			<Code code={bookRootBuildCode} lang="kotlin" theme="github-dark" />
		</div>
		<div class="ba-col">
			<div class="ba-head good">Project starter thật</div>
			<Code code={starterRootBuildCode} lang="kotlin" theme="github-dark" />
