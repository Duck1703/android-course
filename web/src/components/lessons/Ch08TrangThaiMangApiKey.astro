const keysPropertiesCode = `# keys.properties (KHÔNG commit file này)
SPOONACULAR_API_KEY=chuỗi-key-của-bạn`;

const gradleReadKeysCode = `import java.util.Properties

val keys = Properties().apply {
  val f = rootProject.file("keys.properties")
  if (f.exists()) f.inputStream().use { load(it) }
}

android {
  defaultConfig {
