const initSnippet = `init {
  val masterKeyAlias = MasterKeys.getOrCreate(MasterKeys.AES256_GCM_SPEC)

  prefs = EncryptedSharedPreferences.create(
    "encrypted_preferences",
    masterKeyAlias,
    context,
    EncryptedSharedPreferences.PrefKeyEncryptionScheme.AES256_SIV,
    EncryptedSharedPreferences.PrefValueEncryptionScheme.AES256_GCM
  )
}`;

const passCodeSnippet = `fun getPassCode(stringSize: Int): String {
  val randomString = StringBuilder()
  val random = Random.Default
  for (i in 0 until stringSize) {
    randomString.append('a' + random.nextInt(26))
  }
  return randomString.toString()
}`;

const nullCheckSnippet = `// SecurePrefs.getInt tra ve Int (khong nullable)
val currentIndex = prefs.getInt(CURRENT_INDEX_KEY)
if (currentIndex != null) {
  // ...
}`;

const quotaSnippet = `lifecycleScope.launch {
  val storageManager = context.getSystemService<StorageManager>()!!
  val uuid = storageManager.getUuidForPath(context.filesDir)
  val quota = storageManager.getCacheQuotaBytes(uuid)
}`;

const deadCodeHunt = `1. import androidx.room.Room          trong RecipeApp.kt        // dong 38
2. import ...data.Prefs              trong RecipeApp.kt        // dong 39
3. ca file data/Prefs.kt             (class cua chapter 9)
4. import ...platform.LocalContext   trong ShowRecipeList.kt   // dong 58
5. if (currentIndex != null)         trong MainScreen.kt       // dong 68`;

const backupTrap = `# 1. chay app, de no sinh passcode
adb shell run-as com.kodeco.recipefinder ls shared_prefs

# 2. copy file ma hoa ra ngoai (gia lap "backup")
adb shell run-as com.kodeco.recipefinder cat shared_prefs/encrypted_preferences.xml > backup.xml

# 3. xoa du lieu app  -> master key trong Keystore mat theo
adb shell pm clear com.kodeco.recipefinder

# 4. chay lai app (tao master key MOI), roi day file cu de vao`;
