		<thead>
			<tr><th>Nguyên nhân</th><th>Dấu hiệu trong thông báo</th><th>Cách xử lý</th></tr>
		</thead>
		<tbody>
			<tr>
				<td><strong>Mạng</strong> — Gradle không tải được thư viện</td>
