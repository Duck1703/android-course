  onPrimary = Blue20,
  primaryContainer = Blue30,
  ...
)

private val KodeochatLightColorScheme = lightColorScheme(
  primary = Blue40,
  onPrimary = Color.White,
  primaryContainer = Blue90,
  ...
)`;

