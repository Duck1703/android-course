const singletonCode = `/**
 * Provide Singleton instance
 * Better approach is to use Dependency Injection
 */
companion object {
  @Volatile
  private var instance: RepositoryImpl? = null

  fun getInstance() =
    instance ?: synchronized(this) {
      instance ?: RepositoryImpl().also { instance = it }
    }
}`;

