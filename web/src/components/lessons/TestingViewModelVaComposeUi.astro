// O2 — TestingViewModelVaComposeUi.astro — "Testing: test ViewModel & một test UI".
// Workstream F / IMP-051. Bài OPTIONAL, readiness-oriented: dạy thực hành nhập môn,
// không phải bách khoa về testing. Learning job: "Biết viết một ViewModel test có
// giá trị và một test UI nhỏ."
//
// Reuse (đã dạy, KHÔNG dạy lại): S4 ViewModel/StateFlow/mutableStateOf; S5 repository
// boundary + fake-able seam; C5 semantics (testTag dạy tại đây, mục 5.1).
// Không yêu cầu Hilt/DI framework. Fake repository pattern dựng để O6 tái dùng.
//
// Freshness (kiểm 09/09/2026, ghi ở #nguon):
//  - compose-ui-test.junit4 + createComposeRule vẫn là cách chính thức cho test Compose
//    trên Android (instrumented); compose BOM không đổi API onNodeWithText/assertIsDisplayed.
//  - kotlinx-coroutines-test: StandardTestDispatcher + Dispatchers.setMain qua
//    MainDispatcherRule (khuân chính thức developer.android.com — "Test coroutines).
//    runTest là API hiện hành; runBlocking cho test không khuyến khích.
//  - test implementation deps trong ví dụ: dùng version catalog + libs.* theo A14;
//    version cụ thể được để ở tên artifact + ghi chú "lấy bản mới nhất từ BOM/catalog"
//    để không khóa số sai.
import { Code } from "astro:components";

// Snippet 1 — ViewModel cần test (giáo dục tối giản, pattern S4: private Mutable + public StateFlow)
const counterViewModelCode = `class CounterViewModel(private val repository: NotesRepository) : ViewModel() {

  private val _notes = MutableStateFlow<List<String>>(emptyList())
  val notes: StateFlow<List<String>> = _notes.asStateFlow()

  fun addNote(text: String) {
    if (text.isBlank()) return            // quy tắc nghiệp vụ nhỏ — đáng test
    _notes.value = _notes.value + text.trim()
  }
}`;

// Snippet 2 — fake repository: cài interface bằng dữ liệu trong RAM, không DB, không mạng
const fakeRepositoryCode = `class FakeNotesRepository : NotesRepository {
  private val backingFlow = MutableStateFlow<List<String>>(emptyList())

  override fun notes(): StateFlow<List<String>> = backingFlow

  override suspend fun addNote(text: String) {
    backingFlow.value = backingFlow.value + text
  }
}`;

// Snippet 3 — MainDispatcherRule (khuân chính thức của tài liệu Android)
const mainDispatcherRuleCode = `class MainDispatcherRule(
  private val dispatcher: TestDispatcher = StandardTestDispatcher()
) : TestWatcher() {
  override fun starting(description: Description) {
    Dispatchers.setMain(dispatcher)
  }
  override fun finished(description: Description) {
    Dispatchers.resetMain()
  }
}`;

// Snippet 4 — ViewModel test theo Arrange / Act / Assert
const viewModelTestCode = `class CounterViewModelTest {

  @get:Rule
  val mainDispatcherRule = MainDispatcherRule()

  @Test
  fun addNote_boTrangVaTuChoiChuoiRong() = runTest {
    // Arrange — dựng môi trường biết trước kết quả
    val repository = FakeNotesRepository()
    val viewModel = CounterViewModel(repository)

    // Act — gọi đúng hành vi cần kiểm
    viewModel.addNote("  Địa chỉ khách  ")
    viewModel.addNote("   ")               // rỗng → quy tắc nghiệp vụ phải từ chối

    // Assert — đối chiếu với kết quả mong đợi
    val notes = viewModel.notes.first()
    assertEquals(listOf("Địa chỉ khách"), notes)
  }
}`;



// Snippet 6 — testTag đặt có chủ đích trong composable
const testTagCode = `OutlinedTextField(
  value = text,
  onValueChange = onTextChange,
  modifier = Modifier.testTag("note-input")
)

Button(
  onClick = onAddClick,
  modifier = Modifier.testTag("add-button")  // tag cho nút — dùng ở test UI phía dưới
) { Text("Thêm") }`;

// Snippet 7 — dependencies trong libs.versions.toml + module (mức nhận diện)
const depsCode = `[libraries]
junit4 = { module = "junit:junit", version = "4.13.2" }
coroutines-test = { module = "org.jetbrains.kotlinx:kotlinx-coroutines-test", version.ref = "coroutines" }
compose-ui-test = { module = "androidx.compose.ui:ui-test-junit4" }  # version từ BOM
`;

// Snippet 8 — test đơn giản nhất KHÔNG cần rule: hàm thuần Kotlin
const pureFunctionTestCode = `class NoteValidatorTest {
  @Test
  fun chuoiChiToanKhoangTrang_laKhongHopLe() {
    assertFalse(isValidNote("   "))
  }
}`;

// Snippet 9 — màn hình ví dụ để test UI (gộp snippet 6 vào một composable có tên)
const screenShimCode = `// màn hình tối giản của BÀI NÀY — O6 dựng NotesListScreen riêng theo cùng khuôn
@Composable
fun NotesScreen(viewModel: CounterViewModel) {
  val state by viewModel.notes.collectAsState()
  var text by remember { mutableStateOf("") }

  Column {
    OutlinedTextField(
      value = text,
      onValueChange = { text = it },
      modifier = Modifier.testTag("note-input")
    )
    Button(
      onClick = {
        viewModel.addNote(text)
        text = ""
      },
      modifier = Modifier.testTag("add-button")
    ) { Text("Thêm") }
    state.forEach { Text(it) }
  }
}`;

const uiTestCodeClean = `class NotesScreenTest {

  @get:Rule
  val composeRule = createComposeRule()

  @Test
  fun themGhiChu_hienThiTrongDanhSach() {
    // Arrange
    composeRule.setContent {
      NotesScreen(viewModel = CounterViewModel(FakeNotesRepository()))
    }
    // Act
    composeRule.onNodeWithTag("note-input").performTextInput("Mua cà phê")
    composeRule.onNodeWithTag("add-button").performClick()
    // Assert
    composeRule.onNodeWithText("Mua cà phê").assertIsDisplayed()
  }
}`;
