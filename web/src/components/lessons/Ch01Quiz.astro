					<option value="1">1</option>
					<option value="2">2</option>
					<option value="3">3</option>
					<option value="4">4</option>
				</select>
				<span>Hệ thống tạo process cho app và khởi chạy Activity đó</span>
			</li>
			<li data-correct="1">
				<select aria-label="Thứ tự cho bước: người dùng bấm biểu tượng app">
					<option value="">-- số thứ tự --</option>
					<option value="1">1</option>
					<option value="2">2</option>
					<option value="3">3</option>
					<option value="4">4</option>
