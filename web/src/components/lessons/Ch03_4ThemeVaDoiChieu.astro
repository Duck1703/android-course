		<thead>
			<tr><th>#</th><th>Ở đâu</th><th>Tài liệu cũ nói</th><th>Thực tế đã kiểm trong code mẫu / tài liệu chính thức</th><th>Nên theo cái nào</th></tr>
		</thead>
