// Quiz + bài tập cho Chương 1.4 — Gradle và bản đồ khoá học (mục 8, 9, 10, 11, 12).
// Tách từ Ch01Quiz.astro theo ranh giới của 4 chương nhỏ.
// Câu 1, 5, 8, 9, 10 viết lại từ câu 3, 15, 16, 17, 18 của quiz gộp cũ (bỏ giọng bám giáo trình,
//   sửa tham chiếu chéo sang tên chương nhỏ). Câu 2, 3, 4, 6, 7 viết mới cho mục 8.1–8.4 và 9.
// Mọi số dòng / số phiên bản / tên file đều đã mở file thật trong aaf-materials/ để kiểm.
// Quiz chấm bằng vanilla JavaScript phía client, không thêm framework.
const FINAL = "aaf-materials/02-getting-started-with-android-studio/projects/final";

// Sáu dòng cho Bài tập 2 — trích nguyên văn từ {FINAL}/app/build.gradle.kts, khối dependencies
// (dòng 52–69). Sáu dòng này KHÔNG liền nhau trong file thật: lần lượt là dòng 54, 57, 61, 62, 64, 67.
const depsQuizCode = `implementation("androidx.core:core-ktx:1.12.0")
implementation(platform("androidx.compose:compose-bom:2023.10.00"))
implementation("androidx.compose.material3:material3")
testImplementation("junit:junit:4.13.2")
androidTestImplementation("androidx.test.espresso:espresso-core:3.5.1")
debugImplementation("androidx.compose.ui:ui-tooling")`;
