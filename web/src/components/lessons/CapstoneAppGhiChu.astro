  ["Bước 4", "ViewModel + UiState", "NotesViewModel với StateFlow + query filter (S4)", "Preview/Chạy: list trống hiển thị được (empty state)"],
  ["Bước 5", "Màn danh sách", "NotesListScreen: OutlinedTextField tìm + LazyColumn với key (C2)", "Chạy app: list trống + ô tìm hiện ra"],
  ["Bước 6", "Điều hướng", "AppNavHost 2 destination, type-safe route (N2); detail nhận noteId nullable", "Chạm 1 dòng → mở màn trống; Back quay về list"],
  ["Bước 7", "Màn chi tiết/tạo", "NoteDetailScreen + NoteDetailViewModel; save qua repository", "Tạo ghi chú → Back → list hiện nó; sắp xếp mới-nhất-trước"],
  ["Bước 8", "Checkbox + xoá", "toggleDone + swipe/delete qua repository", "Tick đổi màu gạch ngang; xoá khỏi list"],
  ["Bước 9", "Theme (DataStore)", "ThemeRepository + switch ở app bar (D1)", "Đổi theme → app nhớ sau khi khởi động lại"],
  ["Bước 10", "Checkpoint", "(tuỳ chọn) FakeNotesRepository + 1 ViewModel test theo O2", "Test xanh; chạy app bằng fake đổi được chỗ build ViewModel"],
