// O6 — CapstoneAppGhiChu.astro — "Capstone hướng dẫn: app ghi chú của bạn".
// Workstream F / IMP-055. Bài OPTIONAL LỚN NHẤT (~90 phút project track).
// Learning job: lắp các kỹ năng ĐÃ HỌC thành một sản phẩm hoàn chỉnh, theo được
// KHÔNG cần tìm kiếm ngoài.
//
// Prereqs (tất cả đã live): A14 (Gradle/version catalog), C2/C3 (list + Material 3),
// S4 (ViewModel/StateFlow), N1/N2 (NavHost + type-safe args), D1 (DataStore),
// R2/R3 (Room + repository). O2 (fake repository) là RECOMMENDED — bài vẫn theo được
// nếu chưa học O2 (mục testing là checkpoint tuỳ chọn, có cảnh báo rõ).
//
// PRODUCT BOUNDARY (brief §17 — chốt trước khi viết):
//  - Product goal: app ghi chú offline đơn giản — tạo/đọc/sửa trạng thái "đã làm xong",
//    tìm theo tiêu đề, theme sáng/tối nhớ lựa chọn.
//  - Screens: Danh sách (list + search) · Chi tiết/tạo (một màn cho cả hai, theo id) ·
//    (tùy chọn) Cài đặt: chỉ 1 switch theme.
//  - Data model: 1 Entity `NoteEntity` (id, title, body, done, updatedAt) + NoteDao.
//  - Persistence: Room (source of truth) + DataStore (chỉ theme choice).
//  - Navigation: NavHost 2 destination; id qua type-safe route (N2).
//  - State ownership: UI state trong NotesViewModel (StateFlow); theme qua prefs.
//  - Repository boundary: NotesRepository (interface) + RoomNotesRepository.
//  - Optional preference: theme switch (DataStore).
//  - Testing checkpoint: fake repository (O2) — TUỲ CHỌN, không chặn luồng chính.
//
// KHÔNG có: cloud sync, auth, AI, collaboration, backend — không scope creep (§17).
// KHÔNG nhồi W2/W3 (mạng) — capstone này offline thuần: đúng "không force mọi
// technology" (§16). Search là filter cục bộ (không phải mạng).
import { Code } from "astro:components";

const entityCode = `@Entity(tableName = "notes")
data class NoteEntity(
  @PrimaryKey(autoGenerate = true) val id: Long = 0,
  val title: String,
  val body: String,
  val done: Boolean = false,
  val updatedAt: Long = System.currentTimeMillis(),
)`;

const daoCode = `@Dao
interface NoteDao {
  @Query("SELECT * FROM notes ORDER BY updatedAt DESC")
  fun observeAll(): Flow<List<NoteEntity>>

  @Query("UPDATE notes SET done = :done WHERE id = :id")
  suspend fun setDone(id: Long, done: Boolean)

  @Upsert
  suspend fun upsert(note: NoteEntity)

  @Query("DELETE FROM notes WHERE id = :id")
  suspend fun delete(id: Long)
}`;

const repositoryCode = `interface NotesRepository {
  fun observeNotes(): Flow<List<Note>>
  suspend fun save(note: Note)
  suspend fun setDone(id: Long, done: Boolean)
  suspend fun delete(id: Long)
}

class RoomNotesRepository(private val dao: NoteDao) : NotesRepository {
  override fun observeNotes() = dao.observeAll().map { list ->
    list.map { it.toNote() }          // Entity → model domain (S5: repository DỊCH)
  }
  override suspend fun save(note: Note) = dao.upsert(note.toEntity())
  override suspend fun setDone(id: Long, done: Boolean) = dao.setDone(id, done)
  override suspend fun delete(id: Long) = dao.delete(id)
}`;

const viewModelCode = `data class NotesUiState(
  val notes: List<Note> = emptyList(),
  val query: String = "",
) {
  val visible: List<Note>
    get() = if (query.isBlank()) notes
            else notes.filter { it.title.contains(query, ignoreCase = true) }
}

class NotesViewModel(private val repository: NotesRepository) : ViewModel() {

  private val _uiState = MutableStateFlow(NotesUiState())
  val uiState: StateFlow<NotesUiState> = _uiState.asStateFlow()

  init {
    viewModelScope.launch {
      repository.observeNotes().collect { notes ->
        _uiState.update { it.copy(notes = notes) }
      }
    }
  }

  fun onQueryChange(query: String) = _uiState.update { it.copy(query = query) }
  fun toggleDone(id: Long, done: Boolean) = viewModelScope.launch {
    repository.setDone(id, done)
  }
  fun delete(id: Long) = viewModelScope.launch { repository.delete(id) }
}`;

const listScreenCode = `@Composable
fun NotesListScreen(
  onNoteOpen: (Long) -> Unit,
  viewModel: NotesViewModel,
) {
  val state by viewModel.uiState.collectAsStateWithLifecycle()

  Column(Modifier.fillMaxSize()) {
    OutlinedTextField(
      value = state.query,
      onValueChange = viewModel::onQueryChange,
      modifier = Modifier.fillMaxWidth().padding(16.dp),
      placeholder = { Text("Tìm ghi chú") },
    )
    LazyColumn(Modifier.fillMaxSize()) {
      items(state.visible, key = { it.id }) { note ->
        NoteRow(
          note = note,
          onOpen = { onNoteOpen(note.id) },
          onToggleDone = { viewModel.toggleDone(note.id, !note.done) },
        )
      }
    }
  }
}`;

const detailScreenCode = `@Composable
fun NoteDetailScreen(noteId: Long?, viewModel: NoteDetailViewModel) {
  val state by viewModel.uiState.collectAsStateWithLifecycle()

  Column(Modifier.fillMaxSize().padding(16.dp)) {
    OutlinedTextField(
      value = state.title,
      onValueChange = viewModel::onTitleChange,
      placeholder = { Text("Tiêu đề") },
      modifier = Modifier.fillMaxWidth(),
    )
    OutlinedTextField(
      value = state.body,
      onValueChange = viewModel::onBodyChange,
      placeholder = { Text("Nội dung") },
      modifier = Modifier.fillMaxWidth().weight(1f),
    )
    Button(onClick = viewModel::save, modifier = Modifier.fillMaxWidth()) {
      Text("Lưu")
    }
  }
}`;

const navCode = `@Serializable object NotesRoute            // màn danh sách
@Serializable data class NoteDetailRoute(val noteId: Long? = null)  // null = tạo mới

@Composable
fun AppNavHost() {
  val navController = rememberNavController()
  NavHost(navController, startDestination = NotesRoute) {
    composable<NotesRoute> {
      NotesListScreen(
        onNoteOpen = { id -> navController.navigate(NoteDetailRoute(id)) },
        viewModel = notesViewModel,
      )
    }
    composable<NoteDetailRoute> { entry ->
      NoteDetailScreen(
        noteId = entry.toRoute<NoteDetailRoute>().noteId,
        viewModel = detailViewModel,
      )
    }
  }
}`;

const themePrefsCode = `// D1 — DataStore: chỉ MỘT giá trị, đúng công cụ cho giá trị đơn lẻ
val Context.themeStore by preferencesDataStore(name = "theme")
val THEME_KEY = stringPreferencesKey("theme")

class ThemeRepository(private val context: Context) {
  val isDark: Flow<Boolean> = context.themeStore.data
    .map { prefs -> prefs[THEME_KEY] == "dark" }

  suspend fun setDark(dark: Boolean) {
    context.themeStore.edit { it[THEME_KEY] = if (dark) "dark" else "light" }
  }
}`;

