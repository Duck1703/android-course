// Quiz + bài tập nhỏ cho Chương 10.3. Câu hỏi bám nội dung Ch10_3RepositoryViewModel.astro.
// Chuyển từ quiz cũ sang: câu 15 → câu 1, câu 17 → câu 3, câu 18 → câu 4, câu 16 → câu 6 (đã sửa chỗ nói sai
// rằng repository cũng bọc withContext), câu 19 → câu 10; bài sắp thứ tự và Bài 1 cũng chuyển từ quiz cũ.
const vmReadSnippet = `suspend fun getBookmarks() {
  withContext(Dispatchers.IO) {
    val allRecipes = repository.findAllRecipes()
    _bookmarksState.value = recipeDbsToRecipes(allRecipes).toMutableList()
  }
}`;
