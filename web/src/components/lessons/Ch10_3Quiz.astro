<script>
	// IMP-001: chấm bài + "Câu x/N" + retry ẩn→hiện→ẩn do harness chung phụ trách.
	// Nhánh dữ liệu live Astro nhúng các module theo tham chiếu tĩnh, nên form này
	// dùng trực tiếp helper initQuiz thay vì import phụ đã có side-effect riêng.
	import { initQuiz } from "../../scripts/quiz.ts";

	initQuiz();

	// Bài sắp thứ tự nằm ngoài #quiz-form và harness không chấm phần này — giữ code chấm riêng
	// trong cùng <script>, chạy sau initQuiz(), hành vi giữ nguyên như trước.
	const orderBtn = document.getElementById("check-order");
	const orderResult = document.getElementById("order-result");

	orderBtn?.addEventListener("click", () => {
		const items = document.querySelectorAll("#save-order li");
		let correct = 0;

		items.forEach((li) => {
			const select = li.querySelector<HTMLSelectElement>("select");
			li.classList.remove("correct", "incorrect");
			if (select?.value === li.getAttribute("data-correct")) {
				correct++;
				li.classList.add("correct");
			} else {
				li.classList.add("incorrect");
			}
		});

		if (orderResult) {
			orderResult.textContent =
				correct === items.length
					? `Chính xác cả ${items.length} bước — bạn đã nắm được đường đi của dữ liệu.`
					: `Đúng ${correct}/${items.length} bước. Nhớ quy tắc một chiều: UI → ViewModel → Repository → DAO → SQLite.`;
			orderResult.removeAttribute("hidden");
		}
	});
</script>
