const safCreateCode = `// Request code for creating a Text document.
const val CREATE_FILE = 1

fun createFile(activity: Activity) {
  val intent = Intent(Intent.ACTION_CREATE_DOCUMENT).apply {
    addCategory(Intent.CATEGORY_OPENABLE)
    type = "text/plain"
    putExtra(Intent.EXTRA_TITLE, "test.txt")
  }
  activity.startActivityForResult(intent, CREATE_FILE)
}`;

const safModernCode = `// khuôn hiện tại: Activity Result API
class MainActivity : ComponentActivity() {

  private val createDoc = registerForActivityResult(
    ActivityResultContracts.CreateDocument("text/plain")
  ) { uri: Uri? ->
    if (uri == null) return@registerForActivityResult   // nguoi dung bam Back
    contentResolver.openOutputStream(uri)?.bufferedWriter()?.use { out ->
      out.write("This is a test")
    }
  }

  private fun createFile() {
    createDoc.launch("test.txt")
  }
}`;

const safTreeCode = `// xin quyen vao ca MOT THU MUC do nguoi dung chon
private val pickTree = registerForActivityResult(
