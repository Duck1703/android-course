const toUiModels = `private fun toUiModels(messages: List<Message>): List<MessageUiModel> {
  val myUserId = _uiState.value.currentUserId
  return messages.map { message ->
    MessageUiModel(
      text = message.text,
      isFromMe = message.senderId == myUserId
    )
  }
}`;

