const recipeListReal = `@Composable
fun RecipeList() {
  // TODO: Add Prefs
  // TODO: Update RecipeModel
  val viewModel: RecipeViewModel = viewModel(factory = viewModelFactory {
    RecipeViewModel()
  })
  val recipeListState = remember { mutableStateOf(listOf<Recipe>()) }
  val scope = rememberCoroutineScope()
  val uiState by viewModel.uiState.collectAsState()
  LaunchedEffect(Unit) {
    scope.launch {
      viewModel.queryState.collect { state ->
        if (state.number > 0) {
          viewModel.setSearching(false)
        }
      }
    }
    scope.launch {
      viewModel.recipeListState.collect { state ->
        recipeListState.value = state
      }
    }
  }
  Column(modifier = Modifier.fillMaxSize()) {
    ImageRow()
    ChipRow(viewModel)
    if (uiState.allChecked) {
      SearchRow(viewModel)
    }
    if (uiState.allChecked) {
      ShowRecipeList(recipeListState, viewModel)
    } else {
      ShowBookmarks(viewModel)
    }
  }
}`;

const queryRecipeFinal = `suspend fun queryRecipe(
  id: Int,
) {
  viewModelScope.launch(Dispatchers.Default) {
    try {
      val spoonacularRecipe = spoonacularService.queryRecipe(id)
      _recipeState.value = spoonacularRecipe
    } catch (e: Exception) {
      Timber.e(e, "Problems getting Recipe for id $id")
      _recipeState.value = null
    }
  }
}`;

